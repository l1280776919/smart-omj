{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart OMJ",
  "version": "0.1.0",
  "identifier": "com.smartomj.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart OMJ",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/": "resources/",
      "../LICENSE": "licenses/SMART-OMJ-LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "native-runtime/opencv_world4120.dll": "opencv_world4120.dll",
      "native-runtime/msvcp140.dll": "msvcp140.dll",
      "native-runtime/concrt140.dll": "concrt140.dll",
      "native-runtime/vcruntime140.dll": "vcruntime140.dll",
      "native-runtime/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
